# Remnawave panel URL, for example https://fornex.remnawave
REMNAWAVE_URL=https://fornex.remnawave
REMNAWAVE_API_PATH=/api/nodes
REMNAWAVE_API_KEY=
REMNAWAVE_AUTH_HEADER=X-API-Key

# Check-Host asynchronous API.
CHECKHOST_URL=https://check-host.net
CHECKHOST_TYPE=tcp
CHECKHOST_PORT=443
CHECKHOST_MAX_NODES=50
CHECKHOST_TIMEOUT_SECONDS=120
CHECKHOST_POLL_INTERVAL_SECONDS=3
# Russia is the monitored side; Romania and Serbia prove that the node itself
# remains reachable from outside Russia. Separate values with |.
CHECKHOST_RU_TARGETS=Russia
CHECKHOST_CONTROL_TARGETS=Romania|Serbia
CHECK_CONCURRENCY=5

# Paid confirmation for Check-Host suspected blocks. Measurements are private.
RIPE_ATLAS_URL=https://atlas.ripe.net/api/v2
RIPE_ATLAS_API_KEY=
RIPE_ATLAS_TIMEOUT_SECONDS=240
RIPE_ATLAS_POLL_INTERVAL_SECONDS=10
RIPE_ATLAS_MIN_RESULTS=5
RIPE_ATLAS_DAILY_BUDGET=60000
RIPE_ATLAS_LIGHT_MODE=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1003780243318
TELEGRAM_MESSAGE_THREAD_ID=2815

CHECK_INTERVAL_SECONDS=3600
RUN_ONCE=false
REQUEST_TIMEOUT_SECONDS=20
DATABASE_PATH=/app/data/tspu-monitor.sqlite3
LOG_LEVEL=INFO
